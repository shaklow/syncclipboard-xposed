<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <!-- 自定义 signature 权限：保护 SystemUI 进程中的 Bridge receiver，
         仅与本 App 同签名的进程可发送广播。App 与自身签名一致，自动获得授权；
         第三方 App 签名不同，无法获得该权限，因此无法伪造 IPC 广播。 -->
    <permission
        android:name="io.github.erenche.syncclipboard.permission.BRIDGE"
        android:protectionLevel="signature" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="io.github.erenche.syncclipboard.permission.BRIDGE" />

    <application
        android:name=".SyncClipboardApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:description="@string/app_description"
        android:theme="@style/Theme.DayNight">

        <activity
            android:name=".activity.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SplashScreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 长按快捷设置磁贴时由系统启动，进入应用主界面 -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activity.SettingsActivity"
            android:label="@string/activity_settings" />

        <activity
            android:name=".activity.HistoryActivity"
            android:label="@string/activity_history" />

        <activity
            android:name=".activity.TransferActivity"
            android:label="@string/activity_transfer" />

        <!-- 分享接收：作为系统分享目标，收到的文本/文件上传到服务器 -->
        <activity
            android:name=".activity.ShareActivity"
            android:exported="true"
            android:label="@string/share_activity_label">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activity.LogActivity"
            android:label="@string/item_log" />

        <activity
            android:name=".activity.AboutActivity"
            android:label="@string/activity_about" />

        <activity
            android:name=".activity.ThemeSettingsActivity"
            android:label="@string/setting_theme" />

        <activity
            android:name=".activity.OpenSourceLicensesActivity"
            android:label="@string/about_open_source_licenses" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 短信验证码自动上传：静态接收器，进程未启动时系统也能唤醒 -->
        <receiver
            android:name=".receiver.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- 通知验证码自动上传：监听所有应用通知，需用户在系统设置授予"通知访问权限" -->
        <service
            android:name=".receiver.NotificationListener"
            android:exported="false"
            android:label="@string/setting_notification_upload"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 快捷设置磁贴：切换自动同步总开关 -->
        <service
            android:name=".tile.AutoSyncTileService"
            android:exported="true"
            android:icon="@drawable/ic_clipboard_switch"
            android:label="@string/tile_auto_sync"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
